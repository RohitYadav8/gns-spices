generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  password         String?
  role             String    @default("customer")
  phone            String?
  addressLine      String?
  landmark         String?
  city             String?
  postalCode       String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  orders           Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  bg          String?
  text        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          String      @id @default(cuid())
  title       String
  category    String
  desc        String?
  badge       String?
  image       String?
  price       Float
  origin      String?
  inStock     Boolean     @default(true)
  tiers       Json?
  categoryId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  categoryRel Category?   @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "Product_categoryId_fkey")
}

model Order {
  id                  String      @id @default(cuid())
  userId              String?
  status              String      @default("Pending")
  paymentMethod       String      @default("Stripe")
  paymentStatus       String      @default("Pending")
  merchandiseSubtotal Float?
  totalAmount         Float?
  shippingFullName    String?
  shippingEmail       String?
  shippingPhone       String?
  shippingAddressLine String?
  shippingLandmark    String?
  shippingCity        String?
  shippingPostalCode  String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User?       @relation(fields: [userId], references: [id])
  items               OrderItem[]

  @@index([userId], map: "Order_userId_fkey")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  name      String
  quantity  Int
  price     Float
  image     String?
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  discount   Float
  isActive   Boolean   @default(true)
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model B2BApplication {
  id           String   @id @default(cuid())
  fullName     String
  businessName String
  email        String
  phone        String
  businessType String
  city         String
  message      String?
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PrivateLabelInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  brandName   String
  country     String
  productType String
  quantity    String
  message     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuoteRequest {
  id           String   @id @default(cuid())
  fullName     String
  businessName String
  email        String
  phone        String
  businessType String
  city         String
  message      String?
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
